{
  "name": "myeongri-seojae",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "명리서재 — 대운 인생 타임라인",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "pnpm typecheck && pnpm build && vitest run && playwright test",
    "golden:gen": "tsx scripts/gen-golden.ts",
    "gate": "pnpm typecheck && pnpm build:mcp && vitest run",
    "mcp": "tsx src/mcp/index.ts",
    "build:mcp": "vite build -c vite.mcp.config.ts",
    "verify:kasi": "tsx scripts/verify-kasi.ts",
    "gen:terms": "tsx scripts/gen-solar-terms.ts",
    "verify:python": "tsx scripts/verify-python.ts",
    "shots": "playwright test --project=shots --workers=1",
    "fonts": "tsx scripts/fetch-fonts.ts",
    "docs:sync": "tsx scripts/sync-docs.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@sentry/react": "^10.70.0",
    "korean-lunar-calendar": "^0.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "astronomy-engine": "^2.1.19",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "lunar-javascript": "^1.7.4",
    "manseryeok": "^2.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.11"
  },
  "bin": {
    "myeongri-seojae-mcp": "dist-mcp/server.js"
  }
}
